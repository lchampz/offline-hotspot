<Layouts.app flash={@flash}>
  <.header>
    Documents
    <:subtitle>First-aid manuals, local maps, and other files available offline.</:subtitle>
  </.header>

  <div :if={@documentos == []} class="mt-6 text-sm text-zinc-500">
    No documents yet. Drop <code>.pdf</code> files into
    <code>priv/static/documentos</code> and they'll show up here.
  </div>

  <ul :if={@documentos != []} class="mt-6 space-y-2">
    <li :for={documento <- @documentos}>
      <.link href={~p"/documentos/#{documento}"} target="_blank" class="underline">
        {documento}
      </.link>
    </li>
  </ul>
</Layouts.app>
